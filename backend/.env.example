# Spring Boot datasource (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lims
SPRING_DATASOURCE_USERNAME=lims
SPRING_DATASOURCE_PASSWORD=lims

# JWT signing secret (use a long random string in production)
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Bootstrap admin (created on first startup if missing)
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=admin123
FIRST_ADMIN_NAME=系统管理员
